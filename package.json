{
  "name": "operacion-agua-formosa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "data:dem": "tsx scripts/build-terrain.ts",
    "data:osm": "tsx scripts/fetch-osm.ts",
    "data:buildings": "tsx scripts/build-buildings.ts",
    "data:masks": "tsx scripts/build-masks.ts",
    "data:drainage": "tsx scripts/build-drainage.ts",
    "data:zones": "tsx scripts/build-zones.ts",
    "data:thresholds": "tsx scripts/build-thresholds.ts",
    "data:preview": "tsx scripts/preview-dem.ts",
    "data": "npm run data:dem && npm run data:osm && npm run data:buildings && npm run data:masks && npm run data:drainage && npm run data:zones && npm run data:thresholds"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "geotiff": "^3.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
